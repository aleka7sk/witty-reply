# Telegram — create the bot in @BotFather.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_MODE=polling
TELEGRAM_CALLBACK_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_DROP_OLD_UPDATES=false

# Public policy shown before/with consent. Required when APP_ENV=production.
PRIVACY_URL=https://github.com/aleka7sk/witty-reply/blob/main/docs/privacy-policy.md

# Production AI. For a no-cost local smoke test, keep AI_PROVIDER=fake.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_EFFORT=low
AI_MAX_TOKENS=1800
AI_TIMEOUT=45s

# Local/internal provider. Never serve public users through a Max/Pro OAuth session.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=claude-sonnet-5

# Belcanto Threads Copilot. Only these Telegram user IDs can create or publish
# school posts. Keep THREADS_PROVIDER=disabled until the Meta account is ready;
# use fake for a zero-risk end-to-end Telegram smoke test.
BELCANTO_OPERATOR_IDS=
# Threads intentionally gets a larger output cap and per-call deadline than
# ordinary short replies. The cap is not a token-spending target: the provider
# bills actual output, while the headroom prevents a rich scenario portfolio or
# independent editorial review from being truncated.
THREADS_AI_MAX_TOKENS=8192
THREADS_AI_CALL_TIMEOUT=90s
# End-to-end budget for the complete multi-stage editorial pipeline, including
# a bounded repair/fallback path when one stage is unavailable.
THREADS_AI_TIMEOUT=300s
# full logs bounded metadata, scores and—only for evergreen generations—safe
# finalist text/notes. Material-backed generations are always metadata-only so
# operator material cannot be echoed into logs. metadata keeps secret-keyed
# HMAC digests and scores; off disables the editorial audit event.
BELCANTO_REVIEW_LOG_MODE=full
THREADS_PROVIDER=disabled
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
# Public HTTPS origin from which Meta can fetch an approved photo. In webhook
# deployments TELEGRAM_WEBHOOK_URL is reused automatically when this is empty.
# Text-only posts continue to work without either value.
THREADS_MEDIA_BASE_URL=
THREADS_TIMEOUT=20s

# Optional licensed photographic illustration. Anthropic may recommend a visual
# mode, but the app discards model-written queries and derives a fixed,
# scenario-only object/space query before calling Pexels. It then downloads from
# the allowlisted CDN, removes metadata, and keeps attribution/provenance.
THREADS_PHOTO_PROVIDER=disabled
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1
PEXELS_TIMEOUT=10s

# Local Compose PostgreSQL only. Production must use sslmode=require, verify-ca,
# or verify-full; sslmode=disable is rejected when APP_ENV=production.
STORE_DRIVER=postgres
DATABASE_URL=postgres://witty:witty@postgres:5432/witty?sslmode=disable
MIGRATE_ON_START=true
CONTENT_RETENTION=168h
# Ordinary reply/comment source context is kept only in process memory for
# refinements and one-tap scenario correction. Belcanto goal/material briefs use
# the bounded durable workflow described in the privacy policy.
SESSION_TTL=30m

# Optional voice transcription through an HTTPS OpenAI-compatible endpoint.
SPEECH_PROVIDER=disabled
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1

HTTP_ADDRESS=:8080
USAGE_TIMEZONE=Asia/Almaty
LOG_LEVEL=info
APP_ENV=development

# Webhook production example:
# TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://bot.example.com
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=replace-with-bot-api-compatible-secret
# DATABASE_URL=postgres://user:password@db.example/witty?sslmode=verify-full
